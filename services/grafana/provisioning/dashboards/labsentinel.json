{
  "id": null,
  "uid": "labsentinel-main",
  "title": "LabSentinel — Equipment Station",
  "tags": ["bca182", "rt-spark", "lab-sentinel"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(255, 161, 22, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Temperature and humidity",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8 }, "unit": "short" }, "overrides": [
        { "matcher": { "id": "byName", "options": "temperature_c" }, "properties": [{ "id": "unit", "value": "celsius" }, { "id": "displayName", "value": "Temperature (°C)" }] },
        { "matcher": { "id": "byName", "options": "humidity_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "displayName", "value": "Humidity (%)" }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\") |> filter(fn: (r) => r._field == \"temperature_c\" or r._field == \"humidity_pct\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 2,
      "title": "Light and proximity",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 }, "unit": "short" }, "overrides": [
        { "matcher": { "id": "byName", "options": "light_lux" }, "properties": [{ "id": "unit", "value": "lux" }, { "id": "displayName", "value": "Light (lux)" }] },
        { "matcher": { "id": "byName", "options": "light_raw" }, "properties": [{ "id": "displayName", "value": "Light (raw counts)" }] },
        { "matcher": { "id": "byName", "options": "proximity_raw" }, "properties": [{ "id": "displayName", "value": "Proximity (raw counts)" }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\") |> filter(fn: (r) => r._field == \"light_lux\" or r._field == \"light_raw\" or r._field == \"proximity_raw\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 3,
      "title": "Fixture orientation",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "degree", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } }, "overrides": [
        { "matcher": { "id": "byName", "options": "pitch_deg" }, "properties": [{ "id": "displayName", "value": "Pitch (°)" }] },
        { "matcher": { "id": "byName", "options": "roll_deg" }, "properties": [{ "id": "displayName", "value": "Roll (°)" }] }
      ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\") |> filter(fn: (r) => r._field == \"pitch_deg\" or r._field == \"roll_deg\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 4,
      "title": "Motion event",
      "type": "state-timeline",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "Stationary", "color": "green" }, "1": { "text": "Movement detected", "color": "orange" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "showValue": "always", "mergeValues": true, "alignValue": "center", "rowHeight": 0.8, "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\" and r._field == \"motion_event\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 5,
      "title": "Device and network state",
      "type": "state-timeline",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "online": { "text": "Online", "color": "green" }, "offline": { "text": "Offline", "color": "red" }, "1": { "text": "Connected", "color": "green" }, "0": { "text": "Disconnected", "color": "red" } } }] }, "overrides": [] },
      "options": { "showValue": "always", "mergeValues": true, "alignValue": "center", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\") |> filter(fn: (r) => r._field == \"state\" or r._field == \"wifi_connected\" or r._field == \"mqtt_connected\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 6,
      "title": "Commanded and actual indicator state",
      "type": "state-timeline",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "ON": { "text": "On", "color": "green" }, "OFF": { "text": "Off", "color": "gray" }, "UNKNOWN": { "text": "Unknown", "color": "orange" } } }] }, "overrides": [] },
      "options": { "showValue": "always", "mergeValues": true, "alignValue": "center", "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\") |> filter(fn: (r) => r._field == \"requested_state\" or r._field == \"actual_output\" or r._field == \"actual_state\") |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)", "rawQuery": true, "resultFormat": "time_series" }]
    },
    {
      "id": 7,
      "title": "Last device data",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "labsentinel-influxdb" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso", "noValue": "No device data" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "targets": [{ "refId": "A", "query": "from(bucket: \"${INFLUX_BUCKET}\") |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"lab_equipment\" and r.device_id == \"${DEVICE_ID}\" and r._field == \"temperature_c\") |> last()", "rawQuery": true, "resultFormat": "time_series" }]
    }
  ]
}

